rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /sarasavi_books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sarasavi_config/{documentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
